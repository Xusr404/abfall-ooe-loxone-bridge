# Optional shared key for the pickup and log API endpoints.
# Set a long, unique value if these endpoints should require authentication.
LOXONE_BRIDGE_API_KEY=

# Optional host port. The service listens on port 8765 inside the container.
LOXONE_BRIDGE_PORT=8765

# Only needed with compose.published.yaml. Replace OWNER with the GitHub
# account or organization that publishes the image.
ABFALL_OOE_IMAGE=ghcr.io/OWNER/abfall-ooe:latest
